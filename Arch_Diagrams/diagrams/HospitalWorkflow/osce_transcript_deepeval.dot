	n20 -> n22 [label=Metric color=purple]
	n21 -> n22 [label=Metric color=purple]
	n22 -> n23 [label=Results color=purple style=bold]
	n23 -> n24
	n24 -> n25
	n25 -> n26 [label="Pass/Fail" color=green]
	n23 -> n26 [label="High scores"]
